# mechacut.studio behind Cloudflare.
#
# Append the site block to your existing Caddyfile. TLS uses a Cloudflare
# Origin CA certificate (see CLOUDFLARE.md) — Cloudflare terminates the public
# leg, this cert secures Cloudflare -> origin.
#
# IMPORTANT: add the global block below at the TOP of your Caddyfile (once,
# not per-site) so Caddy trusts Cloudflare's edge IPs and forwards the real
# visitor IP to the app. Cloudflare publishes its ranges at:
#   https://www.cloudflare.com/ips/
#
# {
# 	servers {
# 		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 \
# 			103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 \
# 			188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 \
# 			104.16.0.0/13 172.64.0.0/13 131.0.72.0/22
# 	}
# }

mechacut.studio {
	encode zstd gzip
	tls /etc/caddy/certs/mechacut.studio.pem /etc/caddy/certs/mechacut.studio.key
	reverse_proxy 127.0.0.1:8898
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}
