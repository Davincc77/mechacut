.venv/
__pycache__/
*.pyc
.pytest_cache/

# garde-fous secrets (audit 22-11) : rien de ceci ne doit un jour
# être balayé par un add -A — les clés vivent dans Railway, jamais dans
# l’arbre
.env
.env.*
*.key
*.p12
*.pfx
*_key.pem
*_key
secrets/
*.kdbx

# NOTE : les exclusions d’opérations vivent dans
# .git/info/exclude (local-only par volonté du propriétaire)
